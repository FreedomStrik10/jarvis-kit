# Normaliza finales de línea: LF en el repo, LF en el working tree.
* text=auto

# PowerShell en Windows: CRLF en el working tree.
# (El BOM UTF-8 NO se ve afectado: git solo toca finales de línea.)
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios — nunca tocar.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.mov binary
*.wav binary
*.mp3 binary
*.pdf binary
*.zip binary
