# Copia este archivo a `.env` (raíz del proyecto) y rellena los valores.
# `.env` está en .gitignore — NUNCA se sube a git.

# Token que te dio @BotFather (ver docs/TELEGRAM.md)
TELEGRAM_BOT_TOKEN=

# Chat destino, de https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Opcional: ruta alternativa a un .env (si no va en la raíz del proyecto)
# JARVIS_ENV_FILE=C:\ruta\otro\.env
